<?xml version="1.0" encoding="UTF-8"?>
<!-- 模板，不是可直接加载的 plist。由 cutover.sh 安装时替换占位符并写到
     $HOME/Library/LaunchAgents/dev.rokbot.tailcat.plist（生成物不入库）。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__TAILCAT_DIR__/runner.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TAILCAT_DIR</key><string>__TAILCAT_DIR__</string>
    <key>TAILCAT_TARGET</key><string>__TAILCAT_TARGET__</string>
    <key>TAILCAT_PORT</key><string>__TAILCAT_PORT__</string>
  </dict>
  <key>WorkingDirectory</key><string>__TAILCAT_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>Umask</key><integer>63</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__TAILCAT_DIR__/logs/tailcat.log</string>
  <key>StandardErrorPath</key><string>__TAILCAT_DIR__/logs/tailcat.log</string>
</dict>
</plist>
