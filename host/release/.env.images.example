# Copy to .env next to docker-compose.images.yml (or let install-images.sh create it).
# install-images.sh initializes .env with 0600 permissions and validates required settings.

# ------------------------------------------------------------------------------
# 1. Access & Public URL
# ------------------------------------------------------------------------------
# Local listen interface on the Docker host. Use 0.0.0.0 for LAN/remote access behind a firewall.
ROKBOT_LISTEN_ADDRESS=127.0.0.1
# Public port mapped to the Host container's internal port 8000.
ROKBOT_PUBLIC_PORT=18080
# Public port mapped to the Web client's isolated internal port 8001.
ROKBOT_WEB_PUBLIC_PORT=18081
# Public HTTP(S) origin when exposed via a reverse proxy, LAN IP, or iOS OTA itms-services.
# Leave commented out for local loopback access (http://127.0.0.1:18080).
# ROKBOT_PUBLIC_URL=https://bot.example.com
# Optional separate origin for the web client when behind an HTTPS reverse proxy (must differ from ROKBOT_PUBLIC_URL).
# ROKBOT_WEB_PUBLIC_URL=https://web.bot.example.com
TZ=Asia/Singapore

# ------------------------------------------------------------------------------
# 2. Prebuilt Images & Registry Mirror Notes
# ------------------------------------------------------------------------------
# Defaults pull from GitHub Container Registry (GHCR):
# - host: multi-arch (linux/amd64 + linux/arm64)
# - box:  linux/amd64 (requires binfmt/QEMU or Rosetta on ARM64 Docker hosts)
# For Mainland China or private registry mirrors, override either or both values below.
ROKBOT_HOST_IMAGE=ghcr.io/hongfaqiu/rokbot/host:latest
ROKBOT_BOX_IMAGE=ghcr.io/hongfaqiu/rokbot/box:2bb5e41

# ------------------------------------------------------------------------------
# 3. Box Token & Optional Operator CLI Placeholders
# ------------------------------------------------------------------------------
# Keep 'local' for the bundled box container; set a strong random token if connecting an external execution node.
ROKBOT_BOX_TOKEN=local

# The Host container auto-generates its real one-time setup key inside /data/setup-key
# (read via: docker compose --env-file .env -f docker-compose.images.yml exec -T host cat /data/setup-key).
# ROKBOT_ADMIN_PASSWORD and ROKBOT_SETUP_KEY are NOT passed into the Host container and are only
# needed if using host/tools/host-admin.mjs CLI automation:
# ROKBOT_ADMIN_PASSWORD=
# ROKBOT_SETUP_KEY=

# ------------------------------------------------------------------------------
# 4. In-App Model Config, 4-Platform Updates & Routing
# ------------------------------------------------------------------------------
# Allow paired/authorized clients to view, configure, and test AI models directly in-app (/local/model).
ROKBOT_ALLOW_DEVICE_MODEL_CONFIG=1
# Persistent directory inside /data for Android, iOS, macOS, and Windows update packages and manifests.
ROKBOT_UPDATE_DIR=/data/updates
# Optional fixed ExternalShell default machine ID when multiple desktop execution machines are paired.
# ROKBOT_DEFAULT_MACHINE_ID=
# Optional upstream update origin allowlist for Host-proxied update downloads.
# ROKBOT_UPDATE_UPSTREAM_ORIGIN=
# Optional voice-memo playback TTS (OpenAI-compatible POST /audio/speech). When unset, voice memos
# use the voice-chat TTS from Admin > Voice and play as WAV. With these set they play as mp3 (or FORMAT).
# ROKBOT_TTS_ENDPOINT=https://tts.example.com/v1/audio/speech
# ROKBOT_TTS_API_KEY=
# ROKBOT_TTS_MODEL=
# ROKBOT_TTS_VOICE=
# ROKBOT_TTS_FORMAT=mp3

# ------------------------------------------------------------------------------
# 5. Execution Box Resources
# ------------------------------------------------------------------------------
ROKBOT_BOX_SHM_SIZE=1gb
ROKBOT_BOX_MEM_LIMIT=0
SAND_BOX_MAX_WINDOWS=100

# ------------------------------------------------------------------------------
# 6. Optional Compose Project Override
# ------------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME=rokbot

# ------------------------------------------------------------------------------
# 7. Optional Outbound HTTP(S) Proxy (Mainland / Corporate)
# ------------------------------------------------------------------------------
# install-images.sh parses quotes/comments safely and syncs uppercase proxy vars to lowercase for curl.
# Keep localhost, 127.0.0.1, box, and host in NO_PROXY so internal container traffic never hits the proxy.
# Note: Container proxy env vars do NOT proxy `docker pull`; configure the Docker daemon proxy or
# registry-mirrors separately if Docker Hub/GHCR pulls are blocked on this machine.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,box,host
