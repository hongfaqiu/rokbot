ARG PATCH_IMAGE=rokbot-patch-base:local
ARG RUNTIME_IMAGE=rokbot-box-input:97658ad
FROM ${PATCH_IMAGE} AS patch
COPY inputs/host.tgz /inputs/host.tgz
RUN python3 release/patch-host.py --archive /inputs/host.tgz --output /generated

FROM ${RUNTIME_IMAGE}
ARG HOST_REVISION
ARG WEB_BUNDLE_SHA256=
WORKDIR /opt/rokbot
COPY --from=patch /opt/rokbot /opt/rokbot
# The web client bundle (build-docker.py --web-source/--web-bundle); empty unless asked for.
# It holds the official interface: such an image is local-only (see web-client.mjs).
COPY web/ web-bundle/
LABEL dev.rokbot.web-bundle-sha256=${WEB_BUNDLE_SHA256}
COPY --from=patch /generated/original artifacts/host-${HOST_REVISION}/sand-host/
COPY --from=patch /generated/seed seed/
ENV NODE_PATH=/opt/sand/deps:/opt/rokbot/artifacts/host-${HOST_REVISION}/sand-host/node_modules:/opt/sand/sand-host/node_modules:/exec-daemon/node_modules \
    ROKBOT_DATA_DIR=/data ROKBOT_STATE_DIR=/data/runtime \
    ROKBOT_MODEL_ENV=/data/model.env ROKBOT_HOST_DATA_DIR=/data/runtime/host-data \
    ROKBOT_ORIGINAL_HOST=/opt/rokbot/artifacts/host-${HOST_REVISION}/sand-host \
    ROKBOT_RUNTIME_DIR=/opt/rokbot/runtime ROKBOT_RECOVERED_CORE=1 \
    ROKBOT_ALLOW_DEVICE_MODEL_CONFIG=1 ROKBOT_UPDATE_DIR=/data/updates \
    ROKBOT_HOST_BIND=127.0.0.1 ROKBOT_HOST_PORT=1340 \
    ROKBOT_INTERNAL_HOST_URL=http://127.0.0.1:1340 \
    ROKBOT_INTERNAL_HOST_TOKEN_FILE=/data/internal-host-token \
    ROKBOT_NOTIFICATION_URL=http://127.0.0.1:8000/internal/notifications \
    ROKBOT_TAILCAT_BINARY=/opt/rokbot/bin/rokbot-tailcat
EXPOSE 8000 8001
VOLUME ["/data"]
HEALTHCHECK --interval=15s --timeout=15s --start-period=90s --retries=3 CMD ["/exec-daemon/node", "deploy/healthcheck.mjs"]
ENTRYPOINT ["/exec-daemon/node", "/opt/rokbot/deploy/supervisor.mjs"]
